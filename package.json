{
  "name": "nimbo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "worker": "npm --workspace=backend run worker",
    "build": "npm --workspace=backend run build && npm --workspace=frontend run build",
    "test": "npm --workspace=backend run test && npm --workspace=frontend run test",
    "setup:owner": "npm --workspace=backend run setup:owner",
    "generate:vapid": "npm --workspace=backend run generate:vapid",
    "db:migrate": "npm --workspace=backend run db:migrate",
    "db:generate": "npm --workspace=backend run db:generate"
  },
  "allowScripts": {
    "argon2@0.41.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "protobufjs@7.6.6": true,
    "@google/genai@2.32.0": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
