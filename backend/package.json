{
  "name": "nimbo-backend",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "main": "index.cjs",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker/notificationWorker.ts",
    "build:cjs": "esbuild src/app.ts --bundle --platform=node --target=node20 --format=cjs --outfile=app.cjs --external:@prisma/client --external:argon2 --external:pg-boss --external:@google/genai",
    "build": "prisma generate && npm run build:cjs",
    "start": "node app.js",
    "start:worker": "node dist/worker/notificationWorker.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "setup:owner": "tsx src/scripts/setupOwner.ts",
    "generate:vapid": "tsx src/scripts/generateVapid.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.3",
    "pg-boss": "^10.1.4",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
